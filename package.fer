let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'SSH',
        desc = 'SSH connection and scripting using Feral.',
        version = '0.2.1',
        feral = '>=2.6.0',
        author = vec.new('Chirag-Khandelwal <github@mail.chiragkh.me>')
    );

    pkg.requires('libssh', version = '~0.12.0');

    let sshLib = pkg.addTarget('SSH');
    sshLib.findHeaders(info.pkgRoot / 'lib', '(.*).hpp');
    sshLib.findSources(info.pkgRoot / 'lib', '(.*).cpp');

    return feral.ok(pkg);
};